# BioMirror Environment Variables
# Copy this file to .env and fill in your values
# Windows: set these in System Properties > Environment Variables
#          OR use: set VARIABLE_NAME=value in cmd

# ── Security (REQUIRED for production) ─────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
BIOMIRROR_SECRET=change-this-to-a-random-32-char-secret

# ── Database ──────────────────────────────────────────────────────────
# Leave empty for local dev: automatically uses a real SQLite file
# (./biomirror.db, created at the project root) — this IS persistent,
# data survives restarts. It is not an in-memory/demo store.
# For production, set a PostgreSQL URL instead:
#   postgresql+asyncpg://user:password@host:5432/biomirror
DATABASE_URL=

# ── PostgreSQL Docker password (only used by docker-compose.yml) ────
POSTGRES_PASSWORD=change_this_password

# ── AI Coach (optional) ──────────────────────────────────────────────
# Leave empty to use the built-in offline rule-based coach fallback.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── AI Model (Phase 2 — the live API loads this automatically at startup
#    if present; falls back to the Bergman-only engine if missing) ──
# Default (relative to backend/) is models/biomirror_pinn.pt at the project
# root — this only needs setting explicitly for a custom location or in Docker.
PINN_MODEL_PATH=models/biomirror_pinn.pt

# ── Server ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ── CORS (comma-separated origins) ──────────────────────────────────
# For production, replace * with your actual frontend URL
CORS_ORIGINS=*
